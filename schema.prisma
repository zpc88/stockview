generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./stockview.db"
}

model User {
  id                  Int                 @id @default(autoincrement())
  username            String              @unique
  password            String
  nickname            String
  role                String              @default("USER")
  createdAt           DateTime            @default(now())
  watchlist           Watchlist[]
  investments         Investment[]
  investmentSnapshots InvestmentSnapshot[]
  tags                Tag[]
}

model Watchlist {
  id     Int           @id @default(autoincrement())
  userId Int
  symbol String
  name   String
  type   String        @default("stock")
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags   WatchlistTag[]

  @@unique([userId, symbol])
}

model KlineCache {
  id        Int      @id @default(autoincrement())
  symbol    String
  period    String
  date      String
  open      Float
  close     Float
  high      Float
  low       Float
  volume    Float
  amount    Float
  updatedAt DateTime @updatedAt

  @@unique([symbol, period, date])
  @@index([symbol, period])
}

// 每日行情快照（每只股票每天一条，盘中实时更新）
model QuoteHistory {
  id            Int      @id @default(autoincrement())
  symbol        String
  name          String
  date          String   // 交易日期 YYYY-MM-DD
  open          Float
  high          Float
  low           Float
  close         Float   // 最新价（盘中实时更新）
  prevClose     Float   // 昨收
  change        Float
  changePercent Float
  volume        Float   // 成交量(手)
  amount        Float   // 成交额(万)
  updatedAt     DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol])
}

// 基金重仓股缓存
model FundHoldingCache {
  id          Int      @id @default(autoincrement())
  fundSymbol  String
  stockCode   String
  stockName   String
  symbol      String   // sh/sz 前缀
  ratio       Float    // 占净值比(%)
  shares      Float    // 持股数(万股)
  marketValue Float    // 持仓市值(万元)
  reportDate  String   // 季报日期
  updatedAt   DateTime @default(now())

  @@unique([fundSymbol, stockCode])
  @@index([fundSymbol])
}

// 用户投资金额
model Investment {
  id        Int      @id @default(autoincrement())
  userId    Int
  symbol    String   // 股票/基金代码
  name      String   // 股票/基金名称
  type      String   // stock 或 fund
  amount    Float    // 投入金额
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      InvestmentTag[]

  @@index([userId])
}

// 投资组合每日快照
model InvestmentSnapshot {
  id              Int      @id @default(autoincrement())
  userId          Int
  date            String   // 快照日期 YYYY-MM-DD
  totalAmount     Float    // 总投入
  totalValue      Float    // 总市值
  profit          Float    // 盈亏
  profitPercent   Float    // 收益率
  details         String   // JSON 格式的各投资详情
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// 基金估算收益历史记录
model FundEstimateHistory {
  id                  Int      @id @default(autoincrement())
  fundSymbol          String   // 基金代码
  fundName            String   // 基金名称
  date                String   // 日期 YYYY-MM-DD
  estimateChange      Float    // 估算涨跌幅(%)
  holdingsCount       Int      // 重仓股数量
  stockContributions  String   // JSON 格式的各重仓股贡献详情
  createdAt           DateTime @default(now())

  @@unique([fundSymbol, date])
  @@index([fundSymbol])
}

// 用户自定义标签
model Tag {
  id              Int              @id @default(autoincrement())
  userId          Int
  name            String
  color           String           @default("#1677ff")
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlistTags   WatchlistTag[]
  investmentTags  InvestmentTag[]

  @@unique([userId, name])
}

// 自选股/基金标签关联
model WatchlistTag {
  id          Int       @id @default(autoincrement())
  watchlistId Int
  tagId       Int
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, tagId])
}

// 投资记录标签关联
model InvestmentTag {
  id           Int        @id @default(autoincrement())
  investmentId Int
  tagId        Int
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([investmentId, tagId])
}
